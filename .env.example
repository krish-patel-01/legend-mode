# Copy to .env and edit. Every setting here has a working default in app/config.py --
# an empty .env is a valid .env, and this file exists to show what is adjustable and
# why, not to list things you must fill in.
#
# The defaults in app/config.py carry the measurements behind them in comments. If you
# are about to change one of these, read the comment on it there first; several look
# like obvious wins and were measured not to be.

# --- Ollama -----------------------------------------------------------------
# Where the daemon is. Under docker compose this is set to http://ollama:11434
# by the compose file; on a host install the default is right.
# LEGEND_OLLAMA_HOST=http://127.0.0.1:11434

# How many models Ollama keeps resident. **Must be set on the daemon, not here** --
# this process cannot change a running Ollama. Export OLLAMA_MAX_LOADED_MODELS when
# you start `ollama serve`. Measured to make no difference to speed; lower it if RAM
# is tight.
# LEGEND_MAX_LOADED_MODELS=4

# --- Routing ----------------------------------------------------------------
# Route used when every stage of the cascade is unsure.
# LEGEND_DEFAULT_ROUTE=chat

# Skip the stage-3 LLM classifier entirely and fall back to default_route.
# LEGEND_DISABLE_CLASSIFIER=false

# Which models.yaml alias fills the router role: trivial replies, the stage-3
# classifier, and tool selection.
# LEGEND_ROUTER_ALIAS=general

# --- Effort and adjudication ------------------------------------------------
# auto | fast | standard | careful. Pinning is mostly for A/B eval runs.
# LEGEND_DEFAULT_EFFORT=auto

# Cross-model critic. **Off for a measured reason**: on this class of hardware a
# verification pass costs about as much as just answering on the better model, and
# produces a grade instead of a better answer. Turn it on if your critic is fast.
# LEGEND_VERIFY_ENABLED=false

# Answer twice and compare numerically, abstaining on disagreement. Doubles latency
# on the slowest tier.
# LEGEND_SELF_CONSISTENCY=false

# Which tier judges. Must never be the tier that produced the answer.
# LEGEND_CRITIC_ALIAS=think

# --- Retrieval --------------------------------------------------------------
# A missing corpus is inert, not fatal -- this is the normal state on a fresh clone.
# Populate it with: uv run python scripts/ingest.py
# LEGEND_RETRIEVAL_ENABLED=true
# LEGEND_RETRIEVAL_DB=data/corpus.db
# LEGEND_RETRIEVAL_TOP_K=3

# Cosine cut-off for a document chunk. Calibrate with:
#   uv run python scripts/ingest.py --probe "your question"
# Raised from 0.66 after a live false positive; see the comment in app/config.py.
# LEGEND_RETRIEVAL_MIN_SCORE=0.70

# Memories need their own, lower cut-off: they are single sentences, and
# short-to-short similarity runs lower for the same relevance.
# LEGEND_RETRIEVAL_MEMORY_MIN_SCORE=0.55

# Append a server-computed "Sources:" line to grounded replies. Never model-written.
# LEGEND_RETRIEVAL_CITE=true

# --- Tools ------------------------------------------------------------------
# LEGEND_TOOLS_ENABLED=true

# Local SearXNG backing the `web` family. Needs `json` under search.formats or every
# request 403s -- see deploy/searxng/settings.yml.example. Under docker compose this
# is set to http://searxng:8080 by the compose file.
# LEGEND_SEARXNG_URL=http://127.0.0.1:8080

# An Obsidian vault for the `notes` family -- a plain folder of markdown files, which
# is all a vault is. **This is the one setting with no sensible default**, because it
# is a path on your machine. The `notes` family reports itself unavailable while it is
# unset, which is a working state, not an error.
#
# Under docker compose this is read as the *host* directory to mount, and the container
# always sees the vault at /vault. Set it to the host path either way -- compose does
# the remapping, because a host path passed straight through would point at nothing
# inside the container and the family would go quietly unavailable.
# LEGEND_VAULT_PATH=/path/to/your/vault

# --- Persona ----------------------------------------------------------------
# The assistant's name. Unsetting it restores the anonymous persona, which tells the
# model to say it has no name rather than invent one.
# LEGEND_ASSISTANT_NAME=Lucy

# Whether the persona tells the model what it can look up. Measured, and the answer
# was no -- the flag stays so the A/B can be re-run. See app/persona.py.
# LEGEND_PERSONA_CAPABILITIES=false
