# SearXNG configuration for Legend Mode's `web` tool family. **This is the template.**
#
# `up.sh` copies it to settings.yml — which is gitignored — and substitutes a freshly
# generated secret key. Edit this file for changes worth keeping; edit settings.yml for
# local experiments.
#
# **The one line that matters is `json` under `search.formats`.** SearXNG ships with only
# `html` enabled, and every JSON request returns 403 until json is listed here — which
# looks like an auth failure rather than a config default, and is the single most common
# thing to get stuck on.
#
# `use_default_settings: true` means this file is a patch over the shipped defaults rather
# than a replacement, so upgrades keep working and only the differences live here.
use_default_settings: true

server:
  # up.sh replaces this placeholder with a generated key when it writes settings.yml.
  # It signs SearXNG's own preference cookies on a loopback-only instance, so it protects
  # very little — but a literal key committed to a repository is a bad habit regardless,
  # and it is what secret scanners flag.
  secret_key: "GENERATED_BY_UP_SH"

  # The bot limiter exists to stop strangers hammering a public instance. This one is
  # bound to 127.0.0.1 and its only client is the assistant on this machine, so the
  # limiter would be rate-limiting the user against themselves.
  limiter: false
  image_proxy: false

search:
  # html alone is the shipped default and is why /search?format=json 403s.
  formats:
    - html
    - json

  safe_search: 0
  autocomplete: ""

  # A search that hangs costs more than one that fails: the tool call is already inside a
  # request the user is waiting on.
  default_lang: "en"

outgoing:
  request_timeout: 6.0
  max_request_timeout: 10.0
  pool_connections: 10
  pool_maxsize: 10

engines:
  # ahmia and torch are Tor engines; they fail to register on a plain install and log an
  # ERROR on every boot. Disabled so a genuine engine failure is visible in the log
  # instead of being buried under two that always fail.
  - name: ahmia
    disabled: true
  - name: torch
    disabled: true

  # **brave and startpage are disabled because they rate-limit and CAPTCHA a
  # loopback instance almost immediately.** Over one session's use the log held 36
  # SearxEngineCaptchaException and 30 SearxEngineTooManyRequestsException, and
  # /search reported them as `Suspended: too many requests` and `Suspended: CAPTCHA`.
  #
  # A suspended engine is not free. SearXNG waits on it before returning, which is part of
  # why one live search took 56 seconds, and the failures bury real errors in the log. The
  # aggregate loses nothing measurable: with both off, "weather ahmedabad" still returns
  # 26 results led by Ventusky, AccuWeather and The Weather Channel.
  - name: brave
    disabled: true
  - name: startpage
    disabled: true

  # **The `duckduckgo` engine is the lite/JSON endpoint, and it CAPTCHAs like the two
  # above.** Measured 2026-08-10: it answered the first two queries of a session with 10
  # results each, then returned `unresponsive_engines: [[duckduckgo, CAPTCHA]]` for every
  # query after, and stayed that way. A search tool that works twice and then silently
  # returns nothing is worse than one that was never enabled, because the failure looks
  # like "no results" to everything downstream.
  #
  # `duckduckgo web` is the same index reached through html.duckduckgo.com instead, and it
  # does not CAPTCHA: 10/10 results on three consecutive queries, ~2.0 s each, no
  # suspensions. So DuckDuckGo stays — through the door that stays open.
  #
  # weight 2 is what makes it the *preferred* source rather than just another voice:
  # SearXNG scores a result by summing weight/position across the engines that returned
  # it, so doubling the weight floats DuckDuckGo's ranking to the top of the merge while
  # google cse and bing still fill the tail.
  - name: duckduckgo
    disabled: true
  - name: duckduckgo web
    disabled: false
    weight: 2

  # Fallback, and insurance. Before this, `google cse` was the only engine reliably
  # answering — 20 of the 28 results on a typical query — which made one upstream the
  # single point of failure for the whole `web` tool family. bing was measured alongside
  # the others and is the one that simply worked: 10 results on 3/3 queries, 0.6–0.9 s,
  # no suspensions.
  #
  # The engines *not* added here were measured too, and failed differently: mojeek
  # returned 0 results while reporting no error at all (the worst kind), and qwant went
  # `Suspended: access denied` on the second query.
  - name: bing
    disabled: false
